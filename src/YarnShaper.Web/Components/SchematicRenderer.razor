@namespace YarnShaper.Web.Components
@using System.Text

@if (Rows.Count > 0)
{
    <figure class="schematic">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <figcaption>@Label</figcaption>
        }
        <div class="schematic-svg-wrap">
            <svg viewBox="0 0 @SvgWidth.ToString(CultureInfo.InvariantCulture) @SvgHeight.ToString(CultureInfo.InvariantCulture)"
                 style="width: @(SvgWidth.ToString(CultureInfo.InvariantCulture))px; max-width: 100%; height: auto;"
                 role="img"
                 aria-label="@(Label ?? "Shaping schematic")">
                @foreach (var band in Bands)
                {
                    <rect x="@band.X.ToString(CultureInfo.InvariantCulture)"
                          y="@band.Y.ToString(CultureInfo.InvariantCulture)"
                          width="@band.Width.ToString(CultureInfo.InvariantCulture)"
                          height="@RowHeightPx.ToString(CultureInfo.InvariantCulture)"
                          fill="@band.Fill">
                        <title>Row @band.Row.RowNumber: @band.Row.StitchCount sts (@band.Row.Action)</title>
                    </rect>
                }
            </svg>
        </div>
        <p class="schematic-caption">@Rows[0].StitchCount &rarr; @Rows[^1].StitchCount sts &middot; @Rows.Count rows</p>
        <a class="btn-link download-link" download="@FileName" href="@DownloadHref">
            <Icon Name="download" /> Download SVG
        </a>
    </figure>
}

@code {
    /// <summary>Ordered rows for a single garment section (e.g. Back, LeftSleeve).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ShapingRow> Rows { get; set; } = [];

    [Parameter]
    public string? Label { get; set; }

    /// <summary>Optional per-row color mapping (used by the colorway layer). Falls back to <see cref="DefaultFill"/>.</summary>
    [Parameter]
    public Func<ShapingRow, string>? ColorSelector { get; set; }

    [Parameter]
    public double StitchWidthPx { get; set; } = 6;

    [Parameter]
    public double RowHeightPx { get; set; } = 4;

    [Parameter]
    public string DefaultFill { get; set; } = "#7c9c82";

    /// <summary>
    /// True draws row 1 at the top, growing downward (top-down raglan: neck
    /// cast-on at top, underarm at bottom). False draws row 1 at the
    /// bottom, growing upward (bottom-up pieces).
    /// </summary>
    [Parameter]
    public bool RowOneAtTop { get; set; } = true;

    private double SvgWidth => Rows.Count == 0 ? 0 : Rows.Max(r => r.StitchCount) * StitchWidthPx;
    private double SvgHeight => Rows.Count * RowHeightPx;

    private readonly record struct Band(double X, double Y, double Width, string Fill, ShapingRow Row);

    // Computed once and reused for both the on-screen <svg> and the
    // downloadable file, so what a user downloads is always exactly what
    // they saw rendered — never two copies of the same layout math to keep
    // in sync.
    private IReadOnlyList<Band> Bands
    {
        get
        {
            var ordered = Rows.OrderBy(r => r.RowNumber).ToList();
            var bands = new List<Band>(ordered.Count);
            for (var i = 0; i < ordered.Count; i++)
            {
                var row = ordered[i];
                var bandWidth = row.StitchCount * StitchWidthPx;
                var x = (SvgWidth - bandWidth) / 2.0;
                var y = RowOneAtTop ? i * RowHeightPx : SvgHeight - (i + 1) * RowHeightPx;
                var fill = ColorSelector?.Invoke(row) ?? DefaultFill;
                bands.Add(new Band(x, y, bandWidth, fill, row));
            }

            return bands;
        }
    }

    private string FileName =>
        (string.IsNullOrWhiteSpace(Label) ? "schematic" : Label.ToLowerInvariant().Replace(' ', '-')) + ".svg";

    private string DownloadHref => "data:image/svg+xml;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(BuildSvgMarkup()));

    private string BuildSvgMarkup()
    {
        var sb = new StringBuilder();
        sb.Append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ")
          .Append(SvgWidth.ToString(CultureInfo.InvariantCulture)).Append(' ')
          .Append(SvgHeight.ToString(CultureInfo.InvariantCulture)).Append("\">");

        foreach (var band in Bands)
        {
            sb.Append("<rect x=\"").Append(band.X.ToString(CultureInfo.InvariantCulture))
              .Append("\" y=\"").Append(band.Y.ToString(CultureInfo.InvariantCulture))
              .Append("\" width=\"").Append(band.Width.ToString(CultureInfo.InvariantCulture))
              .Append("\" height=\"").Append(RowHeightPx.ToString(CultureInfo.InvariantCulture))
              .Append("\" fill=\"").Append(band.Fill).Append("\" />");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }
}
