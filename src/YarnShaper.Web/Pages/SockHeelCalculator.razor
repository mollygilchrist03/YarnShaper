@page "/sock-heel"
@inject NavigationManager Nav
@inject ProjectStore ProjectStore
@inject IJSRuntime JS

<PageTitle>Sock Heel Calculator</PageTitle>

<h1>Sock Heel Calculator</h1>
<p>Enter a gauge swatch and foot circumference to generate the shaping for a heel-flap-and-gusset, short-row, or afterthought heel.</p>

<div class="calculator-layout">
    <EditForm EditContext="@Editor" OnValidSubmit="Calculate" class="card form-card">
        <DataAnnotationsValidator />

        <div class="field-group">
            <h2>Gauge</h2>
            <div class="form-grid">
                <label>
                    Stitches / inch
                    <InputNumber @bind-Value="Input.StitchesPerInch" @bind-Value:after="Calculate" step="0.1" />
                    <ValidationMessage For="@(() => Input.StitchesPerInch)" />
                </label>
                <label>
                    Rows / inch
                    <InputNumber @bind-Value="Input.RowsPerInch" @bind-Value:after="Calculate" step="0.1" />
                    <ValidationMessage For="@(() => Input.RowsPerInch)" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Construction</h2>
            <div class="form-grid">
                <label>
                    Heel style
                    <InputSelect @bind-Value="Style" @bind-Value:after="Calculate">
                        <option value="@HeelStyle.HeelFlapAndGusset">Heel flap and gusset</option>
                        <option value="@HeelStyle.ShortRowHeel">Short-row heel</option>
                        <option value="@HeelStyle.AfterthoughtHeel">Afterthought heel</option>
                    </InputSelect>
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Measurements (in)</h2>
            <div class="form-grid">
                <label>
                    Foot circumference
                    <InputNumber @bind-Value="Input.FootCircumferenceInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.FootCircumferenceInches)" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Colorway</h2>
            <ColorwayPicker @bind-Value="Colorway" @bind-Value:after="RecomputeRowColors" />
        </div>

        <div class="field-group">
            <h2>Save</h2>
            <div class="save-row">
                <input type="text" placeholder="Project name" @bind="SaveName" @bind:event="oninput" />
                <button type="button" class="btn-primary" @onclick="SaveProject" disabled="@(string.IsNullOrWhiteSpace(SaveName) || SectionRows is null)">Save</button>
            </div>
            @if (SavedConfirmation is not null)
            {
                <p class="save-confirmation">@SavedConfirmation</p>
            }
            <button type="button" class="btn-link share-link" @onclick="CopyShareLink" disabled="@(SectionRows is null)">Copy shareable link</button>
            @if (ShareConfirmation is not null)
            {
                <p class="save-confirmation">@ShareConfirmation</p>
            }
        </div>

        <button type="submit" class="btn-primary">Calculate</button>
    </EditForm>

    <div class="results">
        @if (ErrorMessage is not null)
        {
            <div class="error-banner"><Icon Name="exclamation-triangle-fill" /> @ErrorMessage</div>
        }

        @if (SectionRows is not null)
        {
            <div class="results-toolbar">
                <button type="button" class="btn-link print-button" @onclick="PrintPage">Download as PDF</button>
            </div>

            <div class="summary-stats">
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@Stat1Value" /></span>
                    <span class="label">@Stat1Label</span>
                </div>
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@Stat2Value" /></span>
                    <span class="label">@Stat2Label</span>
                </div>
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@Stat3Value" /></span>
                    <span class="label">@Stat3Label</span>
                </div>
            </div>

            <div class="schematic-row">
                @foreach (var section in PhaseOrder)
                {
                    <SchematicRenderer Label="@LabelFor(section)" Rows="@SectionRows[section]" ColorSelector="@ColorSelectorFor(section)" />
                }
            </div>

            <YardageBreakdown YardageByColor="@(YardageByColor ?? new Dictionary<string, double>())" />
        }
    </div>
</div>

@code {
    private SockHeelInput Input { get; set; } = new();
    private HeelStyle Style { get; set; } = HeelStyle.HeelFlapAndGusset;
    private EditContext Editor { get; set; } = null!;
    private string? ErrorMessage;
    private Dictionary<GarmentSection, List<ShapingRow>>? SectionRows;
    private List<GarmentSection> PhaseOrder = [];
    private Dictionary<GarmentSection, int> PhaseOffsets = [];
    private int TotalHeelRows;

    private int Stat1Value;
    private string Stat1Label = "";
    private int Stat2Value;
    private string Stat2Label = "";
    private int Stat3Value;
    private string Stat3Label = "";

    private StripeSequence Colorway { get; set; } =
        new([new Stripe("#7e9370", 4), new Stripe("#c99a3e", 2)]);

    private IReadOnlyDictionary<int, string>? RowColors;
    private IReadOnlyDictionary<string, double>? YardageByColor;
    private Gauge? CurrentGauge;
    private string SaveName = "";
    private string? SavedConfirmation;
    private string? ShareConfirmation;

    protected override async Task OnInitializedAsync()
    {
        Editor = new EditContext(Input);

        var loadId = QueryStringHelper.GetParam(Nav.Uri, "load");
        if (loadId is not null)
        {
            ApplyPayload(await ProjectStore.LoadPayloadAsync<SockHeelProjectPayload>(loadId));
        }
        else
        {
            var shared = QueryStringHelper.GetParam(Nav.Uri, "s");
            if (shared is not null)
            {
                ApplyPayload(ShareLink.Decode<SockHeelProjectPayload>(shared));
            }
        }

        Calculate();
    }

    private void ApplyPayload(SockHeelProjectPayload? payload)
    {
        if (payload is null) return;

        Input.StitchesPerInch = payload.StitchesPerInch;
        Input.RowsPerInch = payload.RowsPerInch;
        Input.FootCircumferenceInches = payload.FootCircumferenceInches;
        Style = payload.Style;
        Colorway = new StripeSequence(payload.Colorway.Select(s => new Stripe(s.Color, s.RowCount)).ToList());
    }

    private SockHeelProjectPayload BuildPayload() => new(
        Input.StitchesPerInch,
        Input.RowsPerInch,
        Input.FootCircumferenceInches,
        Style,
        Colorway.Stripes.Select(s => new StripeDto(s.Color, s.RowCount)).ToList());

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(SaveName) || SectionRows is null) return;

        await ProjectStore.SaveAsync(SaveName, "sock-heel", BuildPayload());
        SavedConfirmation = $"Saved as \"{SaveName}\". Find it under My Projects.";
        SaveName = "";
    }

    private async Task CopyShareLink()
    {
        if (SectionRows is null) return;

        var url = Nav.ToAbsoluteUri($"sock-heel?s={ShareLink.Encode(BuildPayload())}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            ShareConfirmation = "Link copied to clipboard.";
        }
        catch (JSException)
        {
            ShareConfirmation = url;
        }
    }

    private async Task PrintPage() => await JS.InvokeVoidAsync("print");

    private void Calculate()
    {
        ErrorMessage = null;

        if (!Editor.Validate())
        {
            SectionRows = null;
            RowColors = null;
            YardageByColor = null;
            return;
        }

        try
        {
            var gauge = new Gauge(Input.StitchesPerInch, Input.RowsPerInch);
            var measurements = new SockHeelMeasurements(Input.FootCircumferenceInches);

            var rows = SockHeelShapingCalculator.Calculate(gauge, measurements, Style);
            SectionRows = rows
                .GroupBy(r => r.Section)
                .ToDictionary(g => g.Key, g => g.OrderBy(r => r.RowNumber).ToList());

            PhaseOrder = Style switch
            {
                HeelStyle.HeelFlapAndGusset => [GarmentSection.HeelFlap, GarmentSection.HeelTurn, GarmentSection.Gusset],
                HeelStyle.ShortRowHeel => [GarmentSection.ShortRowHeel],
                HeelStyle.AfterthoughtHeel => [GarmentSection.AfterthoughtHeel],
                _ => [],
            };

            PhaseOffsets = [];
            var offset = 0;
            foreach (var section in PhaseOrder)
            {
                PhaseOffsets[section] = offset;
                offset += SectionRows[section].Count;
            }

            TotalHeelRows = offset;
            SetSummaryStats();
            CurrentGauge = gauge;
            RecomputeRowColors();
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
            SectionRows = null;
            RowColors = null;
            YardageByColor = null;
        }
    }

    private void SetSummaryStats()
    {
        if (SectionRows is null) return;

        switch (Style)
        {
            case HeelStyle.HeelFlapAndGusset:
                var flap = SectionRows[GarmentSection.HeelFlap];
                var turn = SectionRows[GarmentSection.HeelTurn];
                var gusset = SectionRows[GarmentSection.Gusset];
                (Stat1Value, Stat1Label) = (flap[0].StitchCount, "Heel stitches");
                (Stat2Value, Stat2Label) = (turn[^1].StitchCount, "Stitches after turn");
                (Stat3Value, Stat3Label) = (gusset[0].StitchCount, "Gusset peak stitches");
                break;

            case HeelStyle.ShortRowHeel:
                var shortRowHeel = SectionRows[GarmentSection.ShortRowHeel];
                (Stat1Value, Stat1Label) = (shortRowHeel[0].StitchCount, "Heel stitches");
                (Stat2Value, Stat2Label) = (shortRowHeel.Min(r => r.StitchCount), "Stitches at center");
                (Stat3Value, Stat3Label) = (shortRowHeel.Count, "Heel rows");
                break;

            case HeelStyle.AfterthoughtHeel:
                var afterthoughtHeel = SectionRows[GarmentSection.AfterthoughtHeel];
                (Stat1Value, Stat1Label) = (afterthoughtHeel[0].StitchCount, "Stitches picked up");
                (Stat2Value, Stat2Label) = (afterthoughtHeel.Count(r => r.Action == ShapingAction.Decrease), "Decrease rounds");
                (Stat3Value, Stat3Label) = (afterthoughtHeel[^1].StitchCount, "Stitches at closure");
                break;
        }
    }

    private void RecomputeRowColors()
    {
        if (SectionRows is null) return;
        RowColors = ColorwayMapper.MapRowColors(TotalHeelRows, Colorway);
        RecomputeYardage();
    }

    private void RecomputeYardage()
    {
        if (SectionRows is null || CurrentGauge is null) return;

        var coloredRows = PhaseOrder.SelectMany(section =>
            SectionRows[section].Select(r => (r.StitchCount, ColorSelectorFor(section)(r))));

        YardageByColor = YardageEstimator.EstimateYardageByColor(coloredRows, CurrentGauge);
    }

    // A heel style's phases (e.g. flap, turn, gusset) are sequential parts
    // of the same physical construction, so one continuous stripe sequence
    // should flow across all of them even though each section's
    // ShapingRow.RowNumber restarts at 1. This maps a section's local row
    // number back onto the shared global sequence before looking up its
    // color.
    private Func<ShapingRow, string> ColorSelectorFor(GarmentSection section) =>
        row => RowColors?.GetValueOrDefault(row.RowNumber + PhaseOffsets.GetValueOrDefault(section)) ?? "#7e9370";

    private static string LabelFor(GarmentSection section) => section switch
    {
        GarmentSection.HeelFlap => "Heel flap",
        GarmentSection.HeelTurn => "Heel turn",
        GarmentSection.Gusset => "Gusset",
        GarmentSection.ShortRowHeel => "Short-row heel",
        GarmentSection.AfterthoughtHeel => "Afterthought heel",
        _ => section.ToString(),
    };

    private sealed class SockHeelInput
    {
        [Range(0.1, 50, ErrorMessage = "Enter a stitch gauge greater than 0.")]
        public double StitchesPerInch { get; set; } = 5.5;

        [Range(0.1, 50, ErrorMessage = "Enter a row gauge greater than 0.")]
        public double RowsPerInch { get; set; } = 7.5;

        [Range(0.1, 100, ErrorMessage = "Enter a foot circumference greater than 0.")]
        public double FootCircumferenceInches { get; set; } = 8;
    }
}
