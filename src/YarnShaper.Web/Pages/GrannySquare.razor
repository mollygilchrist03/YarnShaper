@page "/granny-square"
@inject NavigationManager Nav
@inject ProjectStore ProjectStore
@inject IJSRuntime JS

<PageTitle>Granny Square Calculator</PageTitle>

<h1>Granny Square Calculator</h1>
<p>Enter a gauge (rounds per inch of growth), a target side length, and a corner count to generate the round-by-round cluster count for a granny motif — 4 for the classic square, or any other count for a hexagon, triangle, and so on.</p>

<div class="calculator-layout">
    <EditForm EditContext="@Editor" OnValidSubmit="Calculate" class="card form-card">
        <DataAnnotationsValidator />

        <div class="field-group">
            <h2>Gauge</h2>
            <div class="form-grid">
                <label>
                    Rounds / inch
                    <InputNumber @bind-Value="Input.RoundsPerInch" @bind-Value:after="Calculate" step="0.1" />
                    <ValidationMessage For="@(() => Input.RoundsPerInch)" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Measurements (in)</h2>
            <div class="form-grid">
                <label>
                    Side length
                    <InputNumber @bind-Value="Input.SideLengthInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.SideLengthInches)" />
                </label>
                <label>
                    Corners
                    <InputNumber @bind-Value="Input.CornerCount" @bind-Value:after="Calculate" step="1" />
                    <ValidationMessage For="@(() => Input.CornerCount)" />
                </label>
            </div>
            <p class="field-hint">4 for a classic granny square, 6 for a granny hexagon, 3 for a triangle motif, and so on.</p>
        </div>

        <div class="field-group">
            <h2>Colorway</h2>
            <ColorwayPicker @bind-Value="Colorway" @bind-Value:after="RecomputeRowColors" />
        </div>

        <div class="field-group">
            <h2>Save</h2>
            <div class="save-row">
                <input type="text" placeholder="Project name" @bind="SaveName" @bind:event="oninput" />
                <button type="button" class="btn-primary" @onclick="SaveProject" disabled="@(string.IsNullOrWhiteSpace(SaveName) || Rows is null)">Save</button>
            </div>
            @if (SavedConfirmation is not null)
            {
                <p class="save-confirmation">@SavedConfirmation</p>
            }
            <button type="button" class="btn-link share-link" @onclick="CopyShareLink" disabled="@(Rows is null)">Copy shareable link</button>
            @if (ShareConfirmation is not null)
            {
                <p class="save-confirmation">@ShareConfirmation</p>
            }
        </div>

        <button type="submit" class="btn-primary">Calculate</button>
    </EditForm>

    <div class="results">
        @if (ErrorMessage is not null)
        {
            <div class="error-banner"><Icon Name="exclamation-triangle-fill" /> @ErrorMessage</div>
        }

        @if (Rows is not null)
        {
            <div class="results-toolbar">
                <button type="button" class="btn-link print-button" @onclick="PrintPage">Download as PDF</button>
            </div>

            <div class="summary-stats">
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@Rows.Count" /></span>
                    <span class="label">Total rounds</span>
                </div>
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@Rows[^1].StitchCount" /></span>
                    <span class="label">Clusters in final round</span>
                </div>
            </div>

            <div class="schematic-row">
                <SchematicRenderer Label="@MotifLabel" Rows="@Rows" ColorSelector="ColorForRow" />
            </div>
        }
    </div>
</div>

@code {
    private GrannySquareInput Input { get; set; } = new();
    private EditContext Editor { get; set; } = null!;
    private string? ErrorMessage;
    private List<ShapingRow>? Rows;

    private StripeSequence Colorway { get; set; } =
        new([new Stripe("#7e9370", 1), new Stripe("#c99a3e", 1)]);

    private IReadOnlyDictionary<int, string>? RowColors;
    private string SaveName = "";
    private string? SavedConfirmation;
    private string? ShareConfirmation;

    private string MotifLabel => Input.CornerCount switch
    {
        3 => "Granny triangle",
        4 => "Granny square",
        5 => "Granny pentagon",
        6 => "Granny hexagon",
        8 => "Granny octagon",
        _ => $"Granny motif ({Input.CornerCount} corners)",
    };

    protected override async Task OnInitializedAsync()
    {
        Editor = new EditContext(Input);

        var loadId = QueryStringHelper.GetParam(Nav.Uri, "load");
        if (loadId is not null)
        {
            ApplyPayload(await ProjectStore.LoadPayloadAsync<GrannySquareProjectPayload>(loadId));
        }
        else
        {
            var shared = QueryStringHelper.GetParam(Nav.Uri, "s");
            if (shared is not null)
            {
                ApplyPayload(ShareLink.Decode<GrannySquareProjectPayload>(shared));
            }
        }

        Calculate();
    }

    private void ApplyPayload(GrannySquareProjectPayload? payload)
    {
        if (payload is null) return;

        Input.RoundsPerInch = payload.RoundsPerInch;
        Input.SideLengthInches = payload.SideLengthInches;
        Input.CornerCount = payload.CornerCount;
        Colorway = new StripeSequence(payload.Colorway.Select(s => new Stripe(s.Color, s.RowCount)).ToList());
    }

    private GrannySquareProjectPayload BuildPayload() => new(
        Input.RoundsPerInch,
        Input.SideLengthInches,
        Input.CornerCount,
        Colorway.Stripes.Select(s => new StripeDto(s.Color, s.RowCount)).ToList());

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(SaveName) || Rows is null) return;

        await ProjectStore.SaveAsync(SaveName, "granny-square", BuildPayload());
        SavedConfirmation = $"Saved as \"{SaveName}\". Find it under My Projects.";
        SaveName = "";
    }

    private async Task CopyShareLink()
    {
        if (Rows is null) return;

        var url = Nav.ToAbsoluteUri($"granny-square?s={ShareLink.Encode(BuildPayload())}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            ShareConfirmation = "Link copied to clipboard.";
        }
        catch (JSException)
        {
            ShareConfirmation = url;
        }
    }

    private async Task PrintPage() => await JS.InvokeVoidAsync("print");

    private void Calculate()
    {
        ErrorMessage = null;

        if (!Editor.Validate())
        {
            Rows = null;
            RowColors = null;
            return;
        }

        try
        {
            var gauge = new Gauge(StitchesPerInch: 1, RowsPerInch: Input.RoundsPerInch);
            var measurements = new GrannySquareMeasurements(Input.SideLengthInches);

            Rows = GrannySquareRoundsCalculator.Calculate(gauge, measurements, Input.CornerCount).OrderBy(r => r.RowNumber).ToList();
            RecomputeRowColors();
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
            Rows = null;
            RowColors = null;
        }
    }

    private void RecomputeRowColors()
    {
        if (Rows is null) return;
        RowColors = ColorwayMapper.MapRowColors(Rows.Count, Colorway);
    }

    private string ColorForRow(ShapingRow row) =>
        RowColors?.GetValueOrDefault(row.RowNumber) ?? "#7e9370";

    private sealed class GrannySquareInput
    {
        [Range(0.1, 50, ErrorMessage = "Enter a round gauge greater than 0.")]
        public double RoundsPerInch { get; set; } = 1.5;

        [Range(0.1, 100, ErrorMessage = "Enter a side length greater than 0.")]
        public double SideLengthInches { get; set; } = 6;

        [Range(3, 12, ErrorMessage = "Enter a corner count between 3 and 12.")]
        public int CornerCount { get; set; } = 4;
    }
}
