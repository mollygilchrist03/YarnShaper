@page "/raglan"

<PageTitle>Raglan Calculator</PageTitle>

<h1>Raglan Yoke Calculator</h1>
<p>Enter a gauge swatch and finished measurements to generate a round-by-round shaping schedule for a top-down raglan yoke.</p>

<div class="calculator-layout">
    <EditForm Model="@Input" OnValidSubmit="Calculate" class="card form-card">
        <DataAnnotationsValidator />

        <div class="field-group">
            <h2>Gauge</h2>
            <div class="form-grid">
                <label>
                    Stitches / inch
                    <InputNumber @bind-Value="Input.StitchesPerInch" step="0.1" />
                </label>
                <label>
                    Rows / inch
                    <InputNumber @bind-Value="Input.RowsPerInch" step="0.1" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Measurements (in)</h2>
            <div class="form-grid">
                <label>
                    Neck circumference
                    <InputNumber @bind-Value="Input.NeckCircumferenceInches" step="0.25" />
                </label>
                <label>
                    Bust circumference
                    <InputNumber @bind-Value="Input.BustCircumferenceInches" step="0.25" />
                </label>
                <label>
                    Upper arm circumference
                    <InputNumber @bind-Value="Input.UpperArmCircumferenceInches" step="0.25" />
                </label>
                <label>
                    Yoke depth
                    <InputNumber @bind-Value="Input.YokeDepthInches" step="0.25" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Colorway</h2>
            <ColorwayPicker @bind-Value="Colorway" @bind-Value:after="RecomputeRowColors" />
        </div>

        <button type="submit" class="btn-primary">Calculate</button>
    </EditForm>

    <div class="results">
        @if (ErrorMessage is not null)
        {
            <div class="error-banner"><Icon Name="exclamation-triangle-fill" /> @ErrorMessage</div>
        }

        @if (SectionRows is not null)
        {
            <div class="summary-stats">
                <div class="summary-stat">
                    <span class="value">@CastOnStitches</span>
                    <span class="label">Cast-on stitches</span>
                </div>
                <div class="summary-stat">
                    <span class="value">@TotalYokeRows</span>
                    <span class="label">Yoke rows</span>
                </div>
                <div class="summary-stat">
                    <span class="value">@FinalUnderarmStitches</span>
                    <span class="label">Stitches at underarm</span>
                </div>
            </div>

            <div class="schematic-row">
                <SchematicRenderer Label="Back" Rows="@SectionRows[GarmentSection.Back]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Front" Rows="@SectionRows[GarmentSection.Front]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Left sleeve" Rows="@SectionRows[GarmentSection.LeftSleeve]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Right sleeve" Rows="@SectionRows[GarmentSection.RightSleeve]" ColorSelector="ColorForRow" />
            </div>
        }
    </div>
</div>

@code {
    private RaglanInput Input { get; set; } = new();
    private string? ErrorMessage;
    private Dictionary<GarmentSection, List<ShapingRow>>? SectionRows;
    private int CastOnStitches;
    private int TotalYokeRows;
    private int FinalUnderarmStitches;

    private StripeSequence Colorway { get; set; } =
        new([new Stripe("#7c9c82", 4), new Stripe("#c98a3e", 2)]);

    private IReadOnlyDictionary<int, string>? RowColors;

    protected override void OnInitialized() => Calculate();

    private void Calculate()
    {
        ErrorMessage = null;
        try
        {
            var gauge = new Gauge(Input.StitchesPerInch, Input.RowsPerInch);
            var measurements = new RaglanMeasurements(
                Input.NeckCircumferenceInches,
                Input.BustCircumferenceInches,
                Input.UpperArmCircumferenceInches,
                Input.YokeDepthInches);

            var rows = RaglanShapingCalculator.Calculate(gauge, measurements);
            SectionRows = rows
                .GroupBy(r => r.Section)
                .ToDictionary(g => g.Key, g => g.OrderBy(r => r.RowNumber).ToList());

            CastOnStitches = SectionRows.Values.Sum(s => s[0].StitchCount);
            TotalYokeRows = SectionRows[GarmentSection.Back].Max(r => r.RowNumber);
            FinalUnderarmStitches = SectionRows.Values.Sum(s => s[^1].StitchCount);
            RecomputeRowColors();
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
            SectionRows = null;
            RowColors = null;
        }
    }

    private void RecomputeRowColors()
    {
        if (SectionRows is null) return;
        RowColors = ColorwayMapper.MapRowColors(TotalYokeRows, Colorway);
    }

    private string ColorForRow(ShapingRow row) =>
        RowColors?.GetValueOrDefault(row.RowNumber) ?? "#7c9c82";

    private sealed class RaglanInput
    {
        public double StitchesPerInch { get; set; } = 5.5;
        public double RowsPerInch { get; set; } = 7.5;
        public double NeckCircumferenceInches { get; set; } = 20;
        public double BustCircumferenceInches { get; set; } = 40;
        public double UpperArmCircumferenceInches { get; set; } = 12;
        public double YokeDepthInches { get; set; } = 8;
    }
}
