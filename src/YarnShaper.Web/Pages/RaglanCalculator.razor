@page "/raglan"
@inject NavigationManager Nav
@inject ProjectStore ProjectStore
@inject IJSRuntime JS

<PageTitle>Raglan Calculator</PageTitle>

<h1>Raglan Yoke Calculator</h1>
<p>Enter a gauge swatch and finished measurements to generate a round-by-round shaping schedule for a top-down raglan yoke.</p>

<div class="calculator-layout">
    <EditForm EditContext="@Editor" OnValidSubmit="Calculate" class="card form-card">
        <DataAnnotationsValidator />

        <div class="field-group">
            <h2>Gauge</h2>
            <div class="form-grid">
                <label>
                    Stitches / inch
                    <InputNumber @bind-Value="Input.StitchesPerInch" @bind-Value:after="Calculate" step="0.1" />
                    <ValidationMessage For="@(() => Input.StitchesPerInch)" />
                </label>
                <label>
                    Rows / inch
                    <InputNumber @bind-Value="Input.RowsPerInch" @bind-Value:after="Calculate" step="0.1" />
                    <ValidationMessage For="@(() => Input.RowsPerInch)" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Measurements (in)</h2>
            <div class="form-grid">
                <label>
                    Neck circumference
                    <InputNumber @bind-Value="Input.NeckCircumferenceInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.NeckCircumferenceInches)" />
                </label>
                <label>
                    Bust circumference
                    <InputNumber @bind-Value="Input.BustCircumferenceInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.BustCircumferenceInches)" />
                </label>
                <label>
                    Upper arm circumference
                    <InputNumber @bind-Value="Input.UpperArmCircumferenceInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.UpperArmCircumferenceInches)" />
                </label>
                <label>
                    Yoke depth
                    <InputNumber @bind-Value="Input.YokeDepthInches" @bind-Value:after="Calculate" step="0.25" />
                    <ValidationMessage For="@(() => Input.YokeDepthInches)" />
                </label>
            </div>
        </div>

        <div class="field-group">
            <h2>Colorway</h2>
            <ColorwayPicker @bind-Value="Colorway" @bind-Value:after="RecomputeRowColors" />
        </div>

        <div class="field-group">
            <h2>Save</h2>
            <div class="save-row">
                <input type="text" placeholder="Project name" @bind="SaveName" @bind:event="oninput" />
                <button type="button" class="btn-primary" @onclick="SaveProject" disabled="@(string.IsNullOrWhiteSpace(SaveName) || SectionRows is null)">Save</button>
            </div>
            @if (SavedConfirmation is not null)
            {
                <p class="save-confirmation">@SavedConfirmation</p>
            }
            <button type="button" class="btn-link share-link" @onclick="CopyShareLink" disabled="@(SectionRows is null)">Copy shareable link</button>
            @if (ShareConfirmation is not null)
            {
                <p class="save-confirmation">@ShareConfirmation</p>
            }
        </div>

        <button type="submit" class="btn-primary">Calculate</button>
    </EditForm>

    <div class="results">
        @if (ErrorMessage is not null)
        {
            <div class="error-banner"><Icon Name="exclamation-triangle-fill" /> @ErrorMessage</div>
        }

        @if (SectionRows is not null)
        {
            <div class="results-toolbar">
                <button type="button" class="btn-link print-button" @onclick="PrintPage">Download as PDF</button>
            </div>

            <div class="summary-stats">
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@CastOnStitches" /></span>
                    <span class="label">Cast-on stitches</span>
                </div>
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@TotalYokeRows" /></span>
                    <span class="label">Yoke rows</span>
                </div>
                <div class="summary-stat">
                    <span class="value"><CountUp Value="@FinalUnderarmStitches" /></span>
                    <span class="label">Stitches at underarm</span>
                </div>
            </div>

            <div class="schematic-row">
                <SchematicRenderer Label="Back" Rows="@SectionRows[GarmentSection.Back]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Front" Rows="@SectionRows[GarmentSection.Front]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Left sleeve" Rows="@SectionRows[GarmentSection.LeftSleeve]" ColorSelector="ColorForRow" />
                <SchematicRenderer Label="Right sleeve" Rows="@SectionRows[GarmentSection.RightSleeve]" ColorSelector="ColorForRow" />
            </div>

            <YardageBreakdown YardageByColor="@(YardageByColor ?? new Dictionary<string, double>())" />
        }
    </div>
</div>

@code {
    private RaglanInput Input { get; set; } = new();
    private EditContext Editor { get; set; } = null!;
    private string? ErrorMessage;
    private Dictionary<GarmentSection, List<ShapingRow>>? SectionRows;
    private int CastOnStitches;
    private int TotalYokeRows;
    private int FinalUnderarmStitches;

    private StripeSequence Colorway { get; set; } =
        new([new Stripe("#7c9c82", 4), new Stripe("#c98a3e", 2)]);

    private IReadOnlyDictionary<int, string>? RowColors;
    private IReadOnlyDictionary<string, double>? YardageByColor;
    private Gauge? CurrentGauge;
    private string SaveName = "";
    private string? SavedConfirmation;
    private string? ShareConfirmation;

    protected override async Task OnInitializedAsync()
    {
        Editor = new EditContext(Input);

        var loadId = QueryStringHelper.GetParam(Nav.Uri, "load");
        if (loadId is not null)
        {
            ApplyPayload(await ProjectStore.LoadPayloadAsync<RaglanProjectPayload>(loadId));
        }
        else
        {
            var shared = QueryStringHelper.GetParam(Nav.Uri, "s");
            if (shared is not null)
            {
                ApplyPayload(ShareLink.Decode<RaglanProjectPayload>(shared));
            }
        }

        Calculate();
    }

    private void ApplyPayload(RaglanProjectPayload? payload)
    {
        if (payload is null) return;

        Input.StitchesPerInch = payload.StitchesPerInch;
        Input.RowsPerInch = payload.RowsPerInch;
        Input.NeckCircumferenceInches = payload.NeckCircumferenceInches;
        Input.BustCircumferenceInches = payload.BustCircumferenceInches;
        Input.UpperArmCircumferenceInches = payload.UpperArmCircumferenceInches;
        Input.YokeDepthInches = payload.YokeDepthInches;
        Colorway = new StripeSequence(payload.Colorway.Select(s => new Stripe(s.Color, s.RowCount)).ToList());
    }

    private RaglanProjectPayload BuildPayload() => new(
        Input.StitchesPerInch,
        Input.RowsPerInch,
        Input.NeckCircumferenceInches,
        Input.BustCircumferenceInches,
        Input.UpperArmCircumferenceInches,
        Input.YokeDepthInches,
        Colorway.Stripes.Select(s => new StripeDto(s.Color, s.RowCount)).ToList());

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(SaveName) || SectionRows is null) return;

        await ProjectStore.SaveAsync(SaveName, "raglan", BuildPayload());
        SavedConfirmation = $"Saved as \"{SaveName}\". Find it under My Projects.";
        SaveName = "";
    }

    private async Task CopyShareLink()
    {
        if (SectionRows is null) return;

        var url = Nav.ToAbsoluteUri($"raglan?s={ShareLink.Encode(BuildPayload())}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            ShareConfirmation = "Link copied to clipboard.";
        }
        catch (JSException)
        {
            ShareConfirmation = url;
        }
    }

    private async Task PrintPage() => await JS.InvokeVoidAsync("print");

    private void Calculate()
    {
        ErrorMessage = null;

        if (!Editor.Validate())
        {
            SectionRows = null;
            RowColors = null;
            YardageByColor = null;
            return;
        }

        try
        {
            var gauge = new Gauge(Input.StitchesPerInch, Input.RowsPerInch);
            var measurements = new RaglanMeasurements(
                Input.NeckCircumferenceInches,
                Input.BustCircumferenceInches,
                Input.UpperArmCircumferenceInches,
                Input.YokeDepthInches);

            var rows = RaglanShapingCalculator.Calculate(gauge, measurements);
            SectionRows = rows
                .GroupBy(r => r.Section)
                .ToDictionary(g => g.Key, g => g.OrderBy(r => r.RowNumber).ToList());

            CastOnStitches = SectionRows.Values.Sum(s => s[0].StitchCount);
            TotalYokeRows = SectionRows[GarmentSection.Back].Max(r => r.RowNumber);
            FinalUnderarmStitches = SectionRows.Values.Sum(s => s[^1].StitchCount);
            CurrentGauge = gauge;
            RecomputeRowColors();
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
            SectionRows = null;
            RowColors = null;
            YardageByColor = null;
        }
    }

    private void RecomputeRowColors()
    {
        if (SectionRows is null) return;
        RowColors = ColorwayMapper.MapRowColors(TotalYokeRows, Colorway);
        RecomputeYardage();
    }

    private void RecomputeYardage()
    {
        if (SectionRows is null || CurrentGauge is null) return;
        var coloredRows = SectionRows.Values.SelectMany(rows => rows).Select(r => (r.StitchCount, ColorForRow(r)));
        YardageByColor = YardageEstimator.EstimateYardageByColor(coloredRows, CurrentGauge);
    }

    private string ColorForRow(ShapingRow row) =>
        RowColors?.GetValueOrDefault(row.RowNumber) ?? "#7c9c82";

    private sealed class RaglanInput
    {
        [Range(0.1, 50, ErrorMessage = "Enter a stitch gauge greater than 0.")]
        public double StitchesPerInch { get; set; } = 5.5;

        [Range(0.1, 50, ErrorMessage = "Enter a row gauge greater than 0.")]
        public double RowsPerInch { get; set; } = 7.5;

        [Range(0.1, 100, ErrorMessage = "Enter a neck circumference greater than 0.")]
        public double NeckCircumferenceInches { get; set; } = 20;

        [Range(0.1, 100, ErrorMessage = "Enter a bust circumference greater than 0.")]
        public double BustCircumferenceInches { get; set; } = 40;

        [Range(0.1, 100, ErrorMessage = "Enter an upper arm circumference greater than 0.")]
        public double UpperArmCircumferenceInches { get; set; } = 12;

        [Range(0.1, 100, ErrorMessage = "Enter a yoke depth greater than 0.")]
        public double YokeDepthInches { get; set; } = 8;
    }
}
