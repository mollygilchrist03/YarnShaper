<div class="brand">
    <a href="" class="brand-link">
        <img src="brand/mark/logo-compact.svg" alt="" class="brand-mark" />
        <span>Yarn Shaper</span>
    </a>
    <button title="Navigation menu" class="nav-toggle" @onclick="ToggleNavMenu">
        <Icon Name="list" />
    </button>
</div>

<nav class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="house-door-fill" /> Home</NavLink>
    <NavLink class="nav-link" href="raglan">Raglan Calculator</NavLink>
    <NavLink class="nav-link" href="sock-heel">Sock Heel Calculator</NavLink>
    <NavLink class="nav-link" href="granny-square">Granny Square Calculator</NavLink>
    <NavLink class="nav-link" href="my-projects">My Projects</NavLink>
</nav>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "nav-links collapsed" : "nav-links";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
